{
  "expo": {
    "name": "WEV",
    "slug": "wev-mobile",
    "scheme": "wev",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0B0F14"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wev.mobile"
    },
    "android": {
      "package": "com.wev.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0B0F14"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "extra": { "apiUrl": "http://10.180.39.174:4000" }
  }
}
